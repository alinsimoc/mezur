{
  "manifest_version": 3,
  "name": "Mezur",
  "version": "1.0",
  "description": "Window size while resizing, page rulers, and on-page distance and box-model measuring.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Mezur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ]
}
